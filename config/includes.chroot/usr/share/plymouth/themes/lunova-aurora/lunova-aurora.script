# ==============================================================================
# Lunova OS 1.0 Aurora - Plymouth Boot Splash Script
# ==============================================================================

# Background
Window.SetBackgroundTopColor(0.03, 0.05, 0.11);    # #080D1C
Window.SetBackgroundBottomColor(0.06, 0.09, 0.18); # #10182D

# Screen Geometry
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Emblem Setup
logo_image = Image("logo.png");
if (logo_image) {
    logo_sprite = Sprite(logo_image);
    logo_x = (screen_width - logo_image.GetWidth()) / 2;
    logo_y = (screen_height - logo_image.GetHeight()) / 2 - 40;
    logo_sprite.SetPosition(logo_x, logo_y, 10);
    logo_sprite.SetOpacity(1.0);
}

# Orbital Progress Spinner / Glow
progress_image = Image("spinner.png");
if (progress_image) {
    progress_sprite = Sprite();
    spin_x = (screen_width - progress_image.GetWidth()) / 2;
    spin_y = logo_y + 160;
    progress_sprite.SetPosition(spin_x, spin_y, 11);
}

angle = 0;
fun refresh_callback () {
    if (progress_image) {
        angle = (angle + 0.06) % 6.283;
        progress_sprite.SetImage(progress_image.Rotate(angle));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Quit Transition
fun quit_callback () {
    if (logo_sprite) logo_sprite.SetOpacity(0);
    if (progress_sprite) progress_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
