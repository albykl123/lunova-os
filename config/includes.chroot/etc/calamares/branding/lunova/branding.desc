# ==============================================================================
# Lunova OS 1.0 Aurora - Calamares Branding Descriptor
# ==============================================================================

---
componentName:  lunova
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 850px,580px
windowPlacement: center

strings:
    productName:         "Lunova OS"
    shortProductName:    "Lunova"
    version:             "1.0.1"
    shortVersion:        "1.0"
    versionCodename:     "Aurora"
    editionName:         "Desktop"
    bootloaderEntryName: "Lunova OS"
    productUrl:          "https://github.com/lunova-os/lunova-os"
    supportUrl:          "https://github.com/lunova-os/lunova-os/issues"
    knownIssuesUrl:      "https://github.com/lunova-os/lunova-os/issues"
    releaseNotesUrl:     "https://github.com/lunova-os/lunova-os/releases"
    donateUrl:           "https://github.com/lunova-os/lunova-os"

images:
    productLogo:         "lunova-installer.svg"
    productIcon:         "lunova-icon.svg"
    productWelcome:      "welcome.png"

style:
   SidebarBackground:    "#10182D"
   SidebarText:          "#F5F7FF"
   SidebarTextCurrent:   "#59D9F8"
   SidebarBackgroundCurrent: "#16203C"
