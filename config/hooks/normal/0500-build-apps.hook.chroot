#!/bin/sh
set -e

echo "==> Configuring Lunova Native Applications..."

APPS="lunova-welcome lunova-about lunova-control-center lunova-assistant lunova-update"

for app in $APPS; do
    if [ -x "/usr/bin/$app" ]; then
        echo "  [OK] Precompiled binary found: /usr/bin/$app"
        chmod +x "/usr/bin/$app"
    elif [ -d "/tmp/lunova-apps/$app" ] && command -v cmake >/dev/null 2>&1; then
        echo "  [*] Compiling $app from source in chroot..."
        mkdir -p "/tmp/lunova-apps/$app/build"
        cd "/tmp/lunova-apps/$app/build"
        cmake .. -DCMAKE_INSTALL_PREFIX=/usr || true
        make -j"$(nproc)" || true
        make install || true
    fi
done

# Clean up temporary build source files from chroot filesystem
rm -rf /tmp/lunova-apps

echo "==> Lunova Native Applications configuration complete."
